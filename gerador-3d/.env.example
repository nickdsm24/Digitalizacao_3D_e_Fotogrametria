# Copie este arquivo para .env e preencha com sua chave real.
# Pegue a chave em: https://developers.tripo3d.com/en/keys

VITE_3D_API_KEY=sua_chave_aqui

# Opcional. Por padrão o app já usa /tripo-api/v3, que o proxy do
# vite.config.ts repassa pra Tripo3D (necessário: o domínio deles bloqueia
# chamadas diretas do navegador via CORS). Só troque essa variável se você
# tiver um backend/proxy próprio em produção.

VITE_3D_API_BASE_URL=/tripo-api/v3